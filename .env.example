# Postgres
POSTGRES_USER=bouquet
POSTGRES_PASSWORD=bouquet_dev_pwd
POSTGRES_DB=bouquet
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173
MEDIA_DIR=/app/media
MEDIA_BASE_URL=/media
# AI_PROVIDER=mock      — no external AI needed (default)
# AI_PROVIDER=comfyui   — ComfyUI + external OpenAI-compatible LLM
# AI_PROVIDER=ollama    — ComfyUI + local Ollama (llama3.1:8b, auto-pulled)
AI_PROVIDER=mock
ENV=dev

# First superadmin (created by seed on first run)
SUPERADMIN_EMAIL=admin@bouquet.local
SUPERADMIN_PASSWORD=admin12345

# LLM settings (used by both comfyui and ollama providers)
# For ollama running natively on Windows: use host.docker.internal
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=none
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_SEC=120

COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_TIMEOUT_SEC=300
COMFYUI_POLL_INTERVAL_SEC=1.5

# Frontend (Vite uses VITE_ prefix). Leave empty to use same-origin proxy
# (vite dev proxy in development; nginx in docker). Set explicitly only if
# the frontend is hosted on a different origin from the backend.
VITE_API_BASE=
